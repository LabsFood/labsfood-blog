# ─── Configuration SMTP OVH ─────────────────────────────────────────────
# Copier ce fichier vers .env.local et remplir les valeurs.
# .env.local est gitignored par défaut, ne JAMAIS le commiter.

# Adresse expéditrice (compte mail OVH actif)
OVH_EMAIL_USER=contact@votre-domaine.fr

# Mot de passe OVH du compte mail
OVH_EMAIL_PASS=mot_de_passe_super_secret

# (Optionnel) Adresse destinataire si différente de OVH_EMAIL_USER
# CONTACT_TO_EMAIL=admin@votre-domaine.fr
