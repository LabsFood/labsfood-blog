# ─── Configuration SMTP Brevo ─────────────────────────────────────────────
# Copier ce fichier vers .env et remplir les valeurs.
# .env est gitignored, ne JAMAIS le commiter.

# Login SMTP Brevo (format : xxxxxxxx@smtp-brevo.com)
BREVO_SMTP_USER=xxxxxxxx@smtp-brevo.com

# Clé SMTP Brevo (générée dans Compte > SMTP & API)
BREVO_SMTP_PASS=xsmtpsib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxxx

# Adresse "from" des emails (doit appartenir à un domaine vérifié dans Brevo)
BREVO_FROM_EMAIL=contact@votre-domaine.fr

# (Optionnel) Destinataire si différent de BREVO_FROM_EMAIL
# CONTACT_TO_EMAIL=admin@votre-domaine.fr
