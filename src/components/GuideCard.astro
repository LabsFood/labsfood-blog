---
import type { Guide } from '../lib/guides';
import { categories } from '../data/categories';
import { readingMinutes } from '../lib/reading-time';
import { frenchTypo } from '../lib/typo.mjs';

interface Props {
  guide: Guide;
  featured?: boolean;
  headingLevel?: 'h2' | 'h3';
}

const { guide, featured = false, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const d = guide.data;
const base = import.meta.env.BASE_URL;
---

<a class:list={['card', { featured }]} href={`${base}${guide.id}/`}>
  <span class="cat">{categories[d.category]}</span>
  <Heading>{frenchTypo(d.title)}</Heading>
  <p>{frenchTypo(d.description)}</p>
  <span class="meta num">{readingMinutes(guide.body)}&nbsp;min de lecture</span>
</a>
