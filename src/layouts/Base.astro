---
import '../styles/global.css';
import { frenchTypo } from '../lib/typo.mjs';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>[];
  /** Barre de progression de lecture (articles). */
  progress?: boolean;
}

const { title, description, type = 'website', jsonLd = [], progress = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL;
const MAIN = 'https://www.labsfood.fr';
const utm = '?utm_source=blog&utm_medium=guides';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{frenchTypo(title)}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={`${base}favicon.png`} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    <meta name="theme-color" content="#FBFCFD" />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Les guides Labs Food" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${MAIN}/og.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="brand" href={base}>
          <img src={`${base}icon.png`} alt="" width="32" height="32" />
          <strong>Labs Food</strong>
          <span>Les guides</span>
        </a>
        <a class="header-link" href={`${MAIN}/${utm}`}>labsfood.fr</a>
      </div>
      {progress && <div class="progress" aria-hidden="true"></div>}
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>
          Ces guides sont édités par <strong>Labs Food</strong>, service de batch cooking à domicile agréé
          services à la personne. Quand nous parlons de notre service ou d’un concurrent, nous le disons
          clairement.
        </p>
        <nav aria-label="Pied de page">
          <a href={`${base}qui-sommes-nous/`}>Qui sommes-nous</a>
          <a href={`${MAIN}/mentions-legales${utm}`}>Mentions légales</a>
          <a href={`${MAIN}/confidentialite${utm}`}>Confidentialité</a>
          <a href={`${MAIN}/${utm}`}>labsfood.fr</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
